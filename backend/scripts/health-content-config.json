      "avoidJargon": true,
      "includePracticalTips": true,
      "addPersonalInsights": true,
      "maintainObjectivity": true,
      "includeDataPoints": true,
      "provideActionableAdvice": true
    },
    "requiredSections": [
      "introduction",
      "key insights",
      "practical tips",
      "recommendations",
      "conclusion"
    ],
    "seoOptimization": {
      "keywordDensity": "1-2%",
      "metaDescriptionLength": "150-160 characters",
      "titleLength": "50-60 characters",
      "includeAltText": true,
      "internalLinking": true
    }
  },

